# ─────────────────────────────────────────────────────────────
# FRONTEND settings (copy to .env.local). These are PUBLIC —
# anything starting with VITE_ is bundled into the browser.
# NEVER put an API secret key in this file.
# ─────────────────────────────────────────────────────────────

# "mock" = built-in demo AI (default, works offline)
# "api"  = send requests to your backend (server/index.js) at VITE_API_BASE_URL
VITE_AI_PROVIDER=mock

# Where the backend lives. "/api" works with the Vite dev proxy (see vite.config.js).
VITE_API_BASE_URL=/api
